# Токен @BotFather. Обязательно замените значение.
BOT_TOKEN=

# ID управляемой супергруппы: отрицательное число, обычно -100...
MANAGED_CHAT_ID=
# ID отдельной группы для проверки членства. Нужен при REQUIRE_SECOND_FACTOR_GROUP=true.
SECOND_FACTOR_CHAT_ID=0
# ID отдельной группы логов и команд /sync, /check.
LOG_CHAT_ID=

# Путь к JSON-ключу сервисного аккаунта Google.
GOOGLE_CREDENTIALS_FILE=credentials.json
# ID таблицы из URL между /d/ и /edit.
GOOGLE_SHEET_ID=

# Название листа ответов формы.
FORM_WORKSHEET_NAME=Форма
# Заголовок колонки кода учебной группы.
FORM_GROUP_COLUMN=группа
# Заголовок колонки Telegram username.
FORM_USERNAME_COLUMN=username

# Название листа черного списка.
BLACKLIST_WORKSHEET_NAME=Черный список
# Заголовок колонки username в черном списке.
BLACKLIST_USERNAME_COLUMN=username
# Заголовок колонки причины.
BLACKLIST_REASON_COLUMN=причина
# Заголовок колонки даты.
BLACKLIST_DATE_COLUMN=дата

# Название листа исключений из проверки кода группы и второй группы.
WHITELIST_WORKSHEET_NAME=Белый список
# Заголовок колонки username в белом списке.
WHITELIST_USERNAME_COLUMN=username

# Полное регулярное выражение допустимого кода: только M31 + две ASCII-цифры.
GROUP_PATTERN=^M31[0-9]{2}$

# Проверять нового участника сразу после вступления: true/false.
KICK_ON_JOIN=true
# Удалять пользователя без публичного Telegram username: true/false.
KICK_USERS_WITHOUT_USERNAME=true
# Интервал фоновой синхронизации в минутах, целое число > 0.
RECHECK_INTERVAL_MINUTES=60
# Срок жизни согласованного снимка таблицы в минутах, целое число > 0.
SHEET_CACHE_MINUTES=5
# Требовать членство во второй группе: true/false.
REQUIRE_SECOND_FACTOR_GROUP=false

# Числовой api_id приложения с my.telegram.org для полного аудита.
TELEGRAM_API_ID=0
# 32-символьный hex api_hash приложения с my.telegram.org.
TELEGRAM_API_HASH=
# Имя локального файла сессии Telethon без расширения.
TELETHON_SESSION_NAME=audit_session
# Защита от ошибки: должен в точности совпадать с MANAGED_CHAT_ID.
AUDIT_GROUP_ID=0
# true только показывает план; false разрешает изменения Telegram и логи в LOG_CHAT_ID.
AUDIT_DRY_RUN=true

# Путь к локальной SQLite-базе увиденных участников.
DB_PATH=members.db
